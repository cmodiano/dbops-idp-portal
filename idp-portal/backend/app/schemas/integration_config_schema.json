{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IntegrationConfig",
  "description": "Config flow for integration: auth_flow steps (obtain_token, call_api), url_ref and credentials per step. ref is fixed to credential_ref (no arbitrary Vault paths).",
  "type": "object",
  "required": ["auth_flow"],
  "additionalProperties": false,
  "properties": {
    "auth_flow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step"],
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "string",
            "enum": ["obtain_token", "call_api"]
          },
          "url_ref": {
            "type": "string",
            "enum": ["base_url", "token_url"]
          },
          "credentials": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "const": "credential_ref"
              },
              "keys": {
                "type": "array",
                "items": { "type": "string" }
              },
              "use_token_from_step": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "response_token_path": {
            "type": "string"
          }
        }
      }
    }
  }
}
