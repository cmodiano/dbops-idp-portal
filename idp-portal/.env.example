# Oracle Database
ORACLE_DSN=localhost:1521/XEPDB1  # use XEPDB1 for Docker (gvenzl/oracle-xe)
ORACLE_USER=idp_app
ORACLE_PASSWORD=changeme
ORACLE_MIN_POOL=2
ORACLE_MAX_POOL=10

# Application
APP_ENV=development
APP_DEBUG=true
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_HOURS=8

# SAML 2.0 SP
SAML_SP_ENTITY_ID=https://idp-portal.example.com/metadata
SAML_SP_ACS_URL=http://localhost:8000/api/v1/auth/saml/callback
SAML_IDP_ENTITY_ID=https://idp.example.com/entity
SAML_IDP_SSO_URL=https://idp.example.com/sso
SAML_IDP_SLO_URL=https://idp.example.com/slo
SAML_IDP_CERT_PATH=
SAML_SP_KEY_PATH=
SAML_SP_CERT_PATH=

# Dev bypass (set to true for local dev without IdP)
AUTH_DEV_BYPASS=false

# HashiCorp Vault (Story 4.2bis)
# Authentication method: Token OR AppRole (not both)
VAULT_ADDR=http://localhost:8200
# Option 1: Token authentication
VAULT_TOKEN=
# Option 2: AppRole authentication (recommended for production)
VAULT_ROLE_ID=
VAULT_SECRET_ID=
