# Django Secret Key (Story 17.5 - REQUIRED in production)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-only-NOT-FOR-PRODUCTION-replace-me

# Oracle Database
ORACLE_DSN=localhost:1521/XEPDB1  # use XEPDB1 for Docker (gvenzl/oracle-xe)
ORACLE_USER=idp_app
# Story 17.5 - REQUIRED in production, no hardcoded default
ORACLE_PASSWORD=dev_password_NOT_FOR_PRODUCTION
ORACLE_MIN_POOL=2
ORACLE_MAX_POOL=10

# Application
APP_ENV=development
APP_DEBUG=true
CORS_ORIGIN=http://localhost:5173

# JWT Secret Key (Story 17.5 - REQUIRED in production)
JWT_SECRET_KEY=dev-jwt-secret-NOT-FOR-PRODUCTION-replace-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_HOURS=8

# SAML 2.0 SP
SAML_SP_ENTITY_ID=https://idp-portal.example.com/metadata
SAML_SP_ACS_URL=http://localhost:8000/api/v1/auth/saml/callback
SAML_IDP_ENTITY_ID=https://idp.example.com/entity
SAML_IDP_SSO_URL=https://idp.example.com/sso
SAML_IDP_SLO_URL=https://idp.example.com/slo
SAML_IDP_CERT_PATH=
SAML_SP_KEY_PATH=
SAML_SP_CERT_PATH=

# Dev bypass (set to true for local dev without IdP)
AUTH_DEV_BYPASS=false

# Execution Simulation (Story 19.0 - dev only)
# Simulates execution progression without real platform calls (AAP/ServiceNow/Vault)
SIMULATE_EXECUTION_DEV=true
SIMULATE_EXECUTION_FAILURE_RATE=0.1
SIMULATE_EXECUTION_STEP_DURATION=2

# HashiCorp Vault (Story 4.2bis, Story 27.6)
# Authentication method: Token OR AppRole (not both)
VAULT_ADDR=http://localhost:8200
# Option 1: Token authentication
VAULT_TOKEN=
# Option 2: AppRole authentication (recommended for production)
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# Vault Enterprise namespace (optional — leave empty for Vault Open Source)
VAULT_NAMESPACE=
# Cache TTL in seconds (default: 300 = 5 min)
VAULT_CACHE_TTL=300
# HTTP request timeout in seconds (default: 10)
VAULT_TIMEOUT=10
# Max retry attempts for transient errors (default: 3)
VAULT_MAX_RETRIES=3
