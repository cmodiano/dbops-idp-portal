# Oracle Database
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=idp_app
ORACLE_PASSWORD=changeme
ORACLE_MIN_POOL=2
ORACLE_MAX_POOL=10

# Application
APP_ENV=development
APP_DEBUG=true
# CORS (preferred): allow one or many origins (comma-separated or JSON list)
# Examples:
#   CORS_ORIGINS=http://localhost:5173
#   CORS_ORIGINS=http://localhost:5173,http://localhost:3000
#   CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ORIGINS=http://localhost:5173
# Legacy (single origin) still supported:
# CORS_ORIGIN=http://localhost:5173

# Frontend base URL used for browser redirects (e.g. SAML callback redirect).
# For API-only usage, you can set this to any client URL (or keep default).
FRONTEND_BASE_URL=http://localhost:5173

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_HOURS=8

# SAML 2.0 SP
SAML_SP_ENTITY_ID=https://idp-portal.example.com/metadata
SAML_SP_ACS_URL=http://localhost:8000/api/v1/auth/saml/callback
SAML_IDP_ENTITY_ID=https://idp.example.com/entity
SAML_IDP_SSO_URL=https://idp.example.com/sso
SAML_IDP_SLO_URL=https://idp.example.com/slo
SAML_IDP_CERT_PATH=
SAML_SP_KEY_PATH=
SAML_SP_CERT_PATH=

# Dev bypass (set to true for local dev without IdP)
AUTH_DEV_BYPASS=false

# SAML callback response mode:
# - redirect: redirects browser to FRONTEND_BASE_URL (portal flow)
# - json: returns tokens in JSON (API-only flow)
SAML_CALLBACK_MODE=redirect
