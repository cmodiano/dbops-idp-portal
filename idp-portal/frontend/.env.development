# Development environment - Django backend local
# This file is used when running `npm run dev` locally

# API Base URL - Django backend running on localhost
VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL for real-time timeline updates
VITE_WS_URL=ws://localhost:8000

# Dev auth mode - bypasses SAML and uses mock user (local dev only)
VITE_DEV_AUTH=true

# Environment identifier
VITE_ENV=development

# Portal authentication methods (ldap, saml) - comma separated
VITE_PORTAL_AUTH_METHODS=ldap,saml

# Execution Simulation (Story 19.0 - forces polling fallback instead of WebSocket)
VITE_SIMULATE_EXECUTION=true
