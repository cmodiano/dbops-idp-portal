# Staging environment - Django backend staging server
# This file is used when deploying to staging

# API Base URL - Django backend staging
VITE_API_BASE_URL=https://staging-api.idp.internal

# WebSocket URL for real-time timeline updates
VITE_WS_URL=wss://staging-api.idp.internal

# Dev auth mode - DISABLED in staging (use real SAML)
VITE_DEV_AUTH=false

# Environment identifier
VITE_ENV=staging
