# Production environment - Django backend production server
# This file is used when deploying to production

# API Base URL - Django backend production
VITE_API_BASE_URL=https://api.idp.internal

# WebSocket URL for real-time timeline updates
VITE_WS_URL=wss://api.idp.internal

# Dev auth mode - DISABLED in production (use real SAML)
VITE_DEV_AUTH=false

# Environment identifier
VITE_ENV=production
