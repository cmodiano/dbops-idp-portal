# Docker Compose local development environment
# Used when building the frontend with --mode docker (see Dockerfile)

# API Base URL - empty so relative URLs go through nginx reverse proxy
VITE_API_BASE_URL=

# WebSocket URL for real-time timeline updates
VITE_WS_URL=ws://localhost:8080

# Dev auth mode - bypasses SAML and uses mock user (local Docker dev only)
VITE_DEV_AUTH=true

# Portal authentication methods (ldap, saml) - comma separated
VITE_PORTAL_AUTH_METHODS=ldap

# Simulation mode: use WebSocket (false) now that backend broadcasts step updates.
# Set to true to force polling fallback instead of WebSocket.
VITE_SIMULATE_EXECUTION=false

# Environment identifier
VITE_ENV=docker
