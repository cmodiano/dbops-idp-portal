# Django Production Environment Configuration
# Copy this file to /etc/idp/django.env and fill in actual values
# This template should NOT contain real secrets

# =============================================================================
# CORE DJANGO SETTINGS
# =============================================================================

# CRITICAL: Never set to True in production (Story 30.1: DEBUG is False by default)
# The application will NOT start in debug mode unless explicitly opted-in via this variable.
DEBUG=False

# Application environment (MUST be production)
APP_ENV=production

# REQUIRED: Application will refuse to start without this (ImproperlyConfigured)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=api.idp.internal,idp.internal

# CORS allowed origins (frontend URL)
CORS_ALLOWED_ORIGINS=https://idp.internal

# =============================================================================
# DATABASE CONFIGURATION (Oracle)
# =============================================================================

# Oracle connection string
# Format: oracle://user:password@host:port/service_name
# Example: oracle://idp_app:SecurePass123@dbhost.company.com:1521/IDPPROD
DATABASE_URL=oracle://CHANGE_DB_USER:CHANGE_DB_PASSWORD@CHANGE_DB_HOST:1521/CHANGE_SERVICE_NAME

# Individual Oracle settings (alternative to DATABASE_URL)
ORACLE_HOST=CHANGE_DB_HOST
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=CHANGE_SERVICE_NAME
ORACLE_USER=CHANGE_DB_USER
ORACLE_PASSWORD=CHANGE_DB_PASSWORD

# =============================================================================
# SAML 2.0 AUTHENTICATION
# =============================================================================

# Service Provider Entity ID
SAML_SP_ENTITY_ID=https://api.idp.internal/saml/metadata

# Identity Provider URL
SAML_IDP_URL=https://sso.company.com/idp/saml

# IDP Certificate path
SAML_IDP_CERT_PATH=/etc/idp/certs/idp.crt

# SP Certificate and Key (REQUIRED if AUTH_DEV_BYPASS=false)
SAML_SP_CERT_PATH=/etc/idp/certs/sp.crt
SAML_SP_KEY_PATH=/etc/idp/certs/sp.key

# Auth dev bypass (MUST be false in production)
AUTH_DEV_BYPASS=false

# JWT settings
# REQUIRED: Application will refuse to start without this (ImproperlyConfigured)
# CRITICAL: Must be different from SECRET_KEY for defense in depth.
# Why different? If JWT_SECRET_KEY is compromised (e.g., leaked in logs, tokens),
# SECRET_KEY (Django sessions, CSRF, signing) remains secure. This separation
# limits the blast radius of a potential key compromise (principle of least privilege).
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION_GENERATE_RANDOM_KEY
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# HashiCorp Vault
VAULT_ADDR=https://vault.company.com
VAULT_TOKEN=CHANGE_VAULT_TOKEN_FROM_VAULT_ADMIN
# Alternative: Use AppRole authentication
# VAULT_ROLE_ID=CHANGE_ROLE_ID
# VAULT_SECRET_ID=CHANGE_SECRET_ID
# Pre-load Vault secrets into cache at worker startup (default: true)
VAULT_CACHE_WARMUP=true

# ServiceNow
SERVICENOW_BASE_URL=https://company.service-now.com
SERVICENOW_AUTH_TOKEN=CHANGE_SERVICENOW_TOKEN_FROM_SERVICENOW_ADMIN
# Alternative: Use basic auth
# SERVICENOW_USERNAME=CHANGE_USERNAME
# SERVICENOW_PASSWORD=CHANGE_PASSWORD

# AAP (Ansible Automation Platform)
AAP_BASE_URL=https://aap.company.com
AAP_TOKEN=CHANGE_AAP_TOKEN_FROM_AAP_ADMIN

# =============================================================================
# OBSERVABILITY
# =============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Structured JSON logging
LOG_FORMAT=json

# Splunk forwarder (if using syslog)
# SPLUNK_FORWARDER=localhost:514

# =============================================================================
# RATE LIMITING (Story 17.11)
# =============================================================================
# Format: <count>/<period> where period = second|minute|hour|day (or s|m|h|d)
# Set RATELIMIT_ENABLED=false to disable (emergency bypass)

RATELIMIT_ENABLED=true

# Authentication endpoints (SAML login, callback) - per IP
THROTTLE_AUTH_RATE=10/minute

# Token refresh endpoint - per IP
THROTTLE_TOKEN_REFRESH_RATE=20/minute

# Execution POST endpoint - per authenticated user
THROTTLE_EXECUTION_RATE=30/minute

# General API endpoints - per authenticated user
THROTTLE_API_RATE=100/minute

# Public/anonymous endpoints - per IP
THROTTLE_PUBLIC_RATE=50/minute

# Cache backend for rate limiting (LocMemCache for single instance, Redis for HA)
# For Redis: CACHE_URL=redis://redis-host:6379/1
RATELIMIT_USE_CACHE=default

# =============================================================================
# FEATURE FLAGS (Story 17.12)
# =============================================================================
# Source: env (JSON env var) or database (CORE_FEATURE_FLAGS table)
FEATURE_FLAGS_SOURCE=env
# Global enable/disable (set false to disable all flags as kill switch)
FEATURE_FLAGS_ENABLED=true
# Cache TTL in seconds (default 300 = 5 minutes)
FEATURE_FLAGS_CACHE_TTL=300
# JSON feature flags config (when FEATURE_FLAGS_SOURCE=env)
# Example: FEATURE_FLAGS={"new_workflow_builder":{"enabled":true,"rollout_percent":100}}
FEATURE_FLAGS={}
# Redis pub/sub for multi-instance cache invalidation (optional)
# See docs/feature-flags-redis-upgrade.md for setup guide
REDIS_URL=redis://localhost:6379/0
FEATURE_FLAGS_PUBSUB_ENABLED=false


# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# -----------------------------------------------------------------------------
# RBAC Security — Superuser Fallback (Story 22.2 CRIT-2)
# -----------------------------------------------------------------------------
# Controls whether Django superusers can bypass DBOPS profile requirement.
# MUST be false in production (principle of least privilege, SOC1 compliance).
# Set to true ONLY in local development for bootstrapping/convenience:
#   ALLOW_SUPERUSER_FALLBACK=true  # Dev mode only
# When true + DEBUG=false: a WARNING log is emitted for each bypass.
ALLOW_SUPERUSER_FALLBACK=false

# Session cookie settings
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True

# HSTS (handled by Nginx, but can be set here too)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Content security
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# DB Resilience (Story 32.1 — Data Guard failover/switchover)
# CONN_MAX_AGE: Max connection lifetime in seconds (default 600 = 10 min)
DB_CONN_MAX_AGE=600
# CONN_HEALTH_CHECKS: Validate connection before reuse (Django 4.1+, key for failover)
DB_CONN_HEALTH_CHECKS=True
# Story 32.2: Retry after DB reconnection (Data Guard FSFO typical < 1 min)
DB_RETRY_MAX_ATTEMPTS=3
DB_RETRY_BACKOFF_BASE=0.5

# Cache backend (optional)
# CACHE_URL=redis://localhost:6379/0

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Timezone
TIME_ZONE=Europe/Paris

# Language
LANGUAGE_CODE=fr-fr

# Static files root (for collectstatic)
STATIC_ROOT=/opt/idp-portal/django_backend/staticfiles

# =============================================================================
# VALIDATION WARNING
# =============================================================================
# IMPORTANT: Before deploying, search for "CHANGE_" in this file
# All CHANGE_* placeholders MUST be replaced with actual values
# Run: grep -n "CHANGE_" /etc/idp/django.env
# Expected output: (empty - no matches)
