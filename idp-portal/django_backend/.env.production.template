# Django Production Environment Configuration
# Copy this file to /etc/idp/django.env and fill in actual values
# This template should NOT contain real secrets

# =============================================================================
# CORE DJANGO SETTINGS
# =============================================================================

# CRITICAL: Never set to True in production
DEBUG=False

# Application environment (MUST be production)
APP_ENV=production

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Example: django-insecure-abc123xyz789...
SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=api.idp.internal,idp.internal

# CORS allowed origins (frontend URL)
CORS_ALLOWED_ORIGINS=https://idp.internal

# =============================================================================
# DATABASE CONFIGURATION (Oracle)
# =============================================================================

# Oracle connection string
# Format: oracle://user:password@host:port/service_name
# Example: oracle://idp_app:SecurePass123@dbhost.company.com:1521/IDPPROD
DATABASE_URL=oracle://CHANGE_DB_USER:CHANGE_DB_PASSWORD@CHANGE_DB_HOST:1521/CHANGE_SERVICE_NAME

# Individual Oracle settings (alternative to DATABASE_URL)
ORACLE_HOST=CHANGE_DB_HOST
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=CHANGE_SERVICE_NAME
ORACLE_USER=CHANGE_DB_USER
ORACLE_PASSWORD=CHANGE_DB_PASSWORD

# =============================================================================
# SAML 2.0 AUTHENTICATION
# =============================================================================

# Service Provider Entity ID
SAML_SP_ENTITY_ID=https://api.idp.internal/saml/metadata

# Identity Provider URL
SAML_IDP_URL=https://sso.company.com/idp/saml

# IDP Certificate path
SAML_IDP_CERT_PATH=/etc/idp/certs/idp.crt

# SP Certificate and Key (REQUIRED if AUTH_DEV_BYPASS=false)
SAML_SP_CERT_PATH=/etc/idp/certs/sp.crt
SAML_SP_KEY_PATH=/etc/idp/certs/sp.key

# Auth dev bypass (MUST be false in production)
AUTH_DEV_BYPASS=false

# JWT settings
# Generate with: openssl rand -hex 32
# Example: a1b2c3d4e5f6...
JWT_SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION_GENERATE_RANDOM_KEY
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# HashiCorp Vault
VAULT_ADDR=https://vault.company.com
VAULT_TOKEN=CHANGE_VAULT_TOKEN_FROM_VAULT_ADMIN
# Alternative: Use AppRole authentication
# VAULT_ROLE_ID=CHANGE_ROLE_ID
# VAULT_SECRET_ID=CHANGE_SECRET_ID

# ServiceNow
SERVICENOW_BASE_URL=https://company.service-now.com
SERVICENOW_AUTH_TOKEN=CHANGE_SERVICENOW_TOKEN_FROM_SERVICENOW_ADMIN
# Alternative: Use basic auth
# SERVICENOW_USERNAME=CHANGE_USERNAME
# SERVICENOW_PASSWORD=CHANGE_PASSWORD

# AAP (Ansible Automation Platform)
AAP_BASE_URL=https://aap.company.com
AAP_TOKEN=CHANGE_AAP_TOKEN_FROM_AAP_ADMIN

# =============================================================================
# OBSERVABILITY
# =============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Structured JSON logging
LOG_FORMAT=json

# Splunk forwarder (if using syslog)
# SPLUNK_FORWARDER=localhost:514

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Session cookie settings
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True

# HSTS (handled by Nginx, but can be set here too)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Content security
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Database connection pool
CONN_MAX_AGE=600

# Cache backend (optional)
# CACHE_URL=redis://localhost:6379/0

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Timezone
TIME_ZONE=Europe/Paris

# Language
LANGUAGE_CODE=fr-fr

# Static files root (for collectstatic)
STATIC_ROOT=/opt/idp-portal/django_backend/staticfiles

# =============================================================================
# VALIDATION WARNING
# =============================================================================
# IMPORTANT: Before deploying, search for "CHANGE_" in this file
# All CHANGE_* placeholders MUST be replaced with actual values
# Run: grep -n "CHANGE_" /etc/idp/django.env
# Expected output: (empty - no matches)
