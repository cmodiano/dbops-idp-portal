[Unit]
Description=IDP Portal Django Backend
Documentation=https://github.com/company/idp-portal
After=network.target postgresql.service oracle.service
Wants=network-online.target

[Service]
Type=notify
User=idp
Group=idp
RuntimeDirectory=idp-django
WorkingDirectory=/opt/idp-portal/django_backend

# Environment file with secrets (not in git)
EnvironmentFile=/etc/idp/django.env

# Gunicorn configuration
# Workers: 2 * CPU_cores + 1 (for 4 vCPU = 9 workers)
ExecStart=/opt/idp-portal/venv/bin/gunicorn idp_backend.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 9 \
    --worker-class sync \
    --timeout 300 \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --max-requests 1000 \
    --max-requests-jitter 50 \
    --access-logfile - \
    --error-logfile - \
    --capture-output \
    --enable-stdio-inheritance \
    --preload

ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID

# Restart configuration
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/idp-portal/django_backend/staticfiles
ReadWritePaths=/var/log/idp-django

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=idp-django

[Install]
WantedBy=multi-user.target
