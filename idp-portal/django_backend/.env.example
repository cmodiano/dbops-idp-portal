# Development Environment Configuration
# Copy to .env and customize for local development
# Story 30.1: SECRET_KEY and JWT_SECRET_KEY are REQUIRED (no fallback)

# Dev mode — set to True for local development only
DEBUG=True

# REQUIRED: Django secret key
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-only-change-in-production-abc123xyz789

# REQUIRED: JWT signing key (MUST be different from SECRET_KEY for defense in depth)
# Why different? If JWT_SECRET_KEY is compromised, SECRET_KEY (sessions/CSRF) remains secure.
# This separation limits the blast radius of a potential key compromise.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-jwt-secret-change-in-production-def456uvw012

# Auth dev bypass for local development without IdP
AUTH_DEV_BYPASS=True

# Oracle Database (local Docker or remote)
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USER=idp_app
ORACLE_PASSWORD=dev_password

# Allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
